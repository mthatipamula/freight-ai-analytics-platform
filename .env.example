# Copy to .env (git-ignored). Authentication uses your gcloud Application Default Credentials:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=my-test-project-279216
BIGQUERY_DATASET=freight_analytics
BIGQUERY_LOCATION=US
VERTEX_LOCATION=global

# Gemini models (GA by default; e.g. gemini-3.1-pro-preview to try the newest preview)
AGENT_MODEL=gemini-2.5-pro
FAST_MODEL=gemini-2.5-flash

# Governance: the most data one agent query may scan
MAX_BYTES_PER_QUERY=200000000
